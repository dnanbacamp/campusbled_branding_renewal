# このファイルは次フェーズ(Sanity CMS結合)で使用する環境変数のプレースホルダーです。
# 現時点ではCMSは未結合のため、コピーしても何も参照されません。
#
# 使い方: cp .env.local.example .env.local して値を埋める(CMS結合フェーズで)

# Sanity プロジェクト設定
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# 書き込み・ドラフト参照用のトークン(サーバー側のみで使用、NEXT_PUBLIC_を付けない)
SANITY_API_READ_TOKEN=

# CMS更新Webhookからのオンデマンド再検証(ISR)を認証するための秘密値
REVALIDATE_SECRET=
